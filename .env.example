# Use "rule" for the offline Jev-like simulator or "jev" for either the
# official Jev API or any compatible endpoint such as KonghaYao/laya-jev.
# The browser never receives this key.
DECISION_PROVIDER=rule
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
PORT=8787

# Local laya-jev example:
# DECISION_PROVIDER=jev
# TYPESAFE_API_KEY=local
# TYPESAFE_BASE_URL=http://127.0.0.1:8077
# TYPESAFE_MODEL=jev-latest
